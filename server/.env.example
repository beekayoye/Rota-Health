# Server environment variables example
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (Supabase PostgreSQL)
# Pooled connection via PgBouncer on port 6543 (used by API and Worker)
DATABASE_URL=postgresql://postgres.example:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# Direct connection on port 5432 (required by API for Prisma migrations; not needed by Worker)
DIRECT_URL=postgresql://postgres.example:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Redis (Upstash / Railway Redis TCP connection)
# Single TCP connection string used by both ioredis and BullMQ (rediss://... for TLS in production)
REDIS_URL=redis://default:example_token@example.upstash.io:6379

# Auth
JWT_SECRET=development_jwt_secret_min_32_characters_long_for_hmac

# Public URL for generating member invite links (API only)
PUBLIC_BASE_URL=https://api-production-xxxx.up.railway.app

# Error tracking (Sentry Node DSN)
SENTRY_DSN=
