# Server environment variables example
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Pooled connection via PgBouncer on port 6543
DATABASE_URL=postgresql://postgres.example:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# Direct connection on port 5432 (used by Prisma migrations)
DIRECT_URL=postgresql://postgres.example:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Redis (Upstash)
REDIS_URL=redis://default:example_token@example.upstash.io:6379

# Auth & Cryptography
JWT_SECRET=development_jwt_secret_min_32_characters_long_for_hmac
CARD_TOKEN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Third-party services
FLW_SECRET_KEY=FLWSECK_TEST-example
FLW_SECRET_HASH=example_secret_hash
RESEND_API_KEY=re_example
SENTRY_DSN=
